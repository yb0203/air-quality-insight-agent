# Copy to .env and fill in. Only needed for live runs; tests, replay and the demo need no keys.
# Free OpenAQ key: https://explore.openaq.org (account settings)
OPENAQ_API_KEY=
# Optional: Claude writes the messages when set; templates are used otherwise
ANTHROPIC_API_KEY=
# Optional: database URL (default sqlite:///data/aqagent.db)
DATABASE_URL=
